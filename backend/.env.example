# 环境变量配置文件

# 应用配置
APP_NAME=刷刷题系统
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///./shuashuati.db

# JWT 配置（生产环境请更换为强密钥）
SECRET_KEY=your-secret-key-please-change-in-production-very-important
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# AES 加密配置（用于加密 API Key，必须是 32 字节）
AES_KEY=change-this-to-32-bytes-secret

# CORS 配置
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
